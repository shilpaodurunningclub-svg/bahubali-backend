# Copy this file to .env and fill in your real values.
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Start with the TEST keys (they start with rzp_test_) before going live.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Gmail App Password — https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account)
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=youraddress@gmail.com

# Admin key for /admin/report.html and the registrations API
ADMIN_KEY=choose_a_strong_random_string

PORT=4000
